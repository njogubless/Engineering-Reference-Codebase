# Copy to .env for local development. Never commit .env.
# Comments must be on their own line: django-environ keeps inline
# comments as part of the value.
# Every variable is documented in docs/patterns/26-configuration/README.md.

# development | test | staging | production
ENVIRONMENT=development
DEBUG=true
# staging/production require a strong random value
SECRET_KEY=change-me-dev-only-at-least-32-bytes-long
ALLOWED_HOSTS=localhost,127.0.0.1

# infrastructure/docker/compose.yaml exposes Postgres on 5433 and Redis on 6380.
DATABASE_URL=postgres://reference:reference@localhost:5433/django_reference
REDIS_URL=redis://localhost:6380/0

LOG_LEVEL=INFO
# json in deployed environments
LOG_FORMAT=console

FEATURE_SEARCH_V2=false
FEATURE_MAINTENANCE_BANNER=false
CORS_ALLOWED_ORIGINS=http://localhost:5410,http://localhost:5420

# Firebase: the demo- project works only with the emulators (see firebase/README.md).
FIREBASE_PROJECT_ID=demo-reference
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Email goes to Mailpit in development (web UI: http://localhost:8025).
EMAIL_HOST=localhost
EMAIL_PORT=1025
FRONTEND_BASE_URL=http://localhost:5410
