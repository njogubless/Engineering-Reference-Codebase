# Used by tests and CI (DJANGO_ENV_FILE=.env.test). Contains no real secrets.
ENVIRONMENT=test
DEBUG=false
SECRET_KEY=test-only-not-secret
ALLOWED_HOSTS=testserver,localhost
DATABASE_URL=postgres://reference:reference@localhost:5433/django_reference
REDIS_URL=redis://localhost:6380/15
LOG_LEVEL=WARNING
LOG_FORMAT=json
FEATURE_SEARCH_V2=false
FEATURE_MAINTENANCE_BANNER=true
CORS_ALLOWED_ORIGINS=http://app.test
