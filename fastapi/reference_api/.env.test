# Used by tests and CI. Contains no real secrets.
ENVIRONMENT=test
SECRET_KEY=test-only-not-secret-but-long-enough-for-hmac-sha256
DEBUG=false
DATABASE_URL=postgresql://reference:reference@localhost:5433/fastapi_reference_test
REDIS_URL=redis://localhost:6380/14
LOG_LEVEL=WARNING
LOG_FORMAT=json
FEATURE_SEARCH_V2=false
FEATURE_MAINTENANCE_BANNER=true
CORS_ALLOWED_ORIGINS=http://app.test
# Speed only: cheap Argon2 for tests. Deployed environments reject lowered costs.
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST_KIB=1024
FIREBASE_PROJECT_ID=demo-reference
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
EMAIL_HOST=localhost
EMAIL_PORT=1025
FRONTEND_BASE_URL=http://app.test
