# Copy to .env for local development. Never commit .env.
# Comments must be on their own line: django-environ keeps inline
# comments as part of the value.
# Variables are documented in docs/patterns/26-configuration/README.md.
# development | test | staging | production
ENVIRONMENT=development
DEBUG=true
# infrastructure/docker/compose.yaml exposes Postgres on 5433 and Redis on 6380.
DATABASE_URL=postgresql://reference:reference@localhost:5433/fastapi_reference
REDIS_URL=redis://localhost:6380/1
LOG_LEVEL=INFO
# json in deployed environments
LOG_FORMAT=console
FEATURE_SEARCH_V2=false
FEATURE_MAINTENANCE_BANNER=false
CORS_ALLOWED_ORIGINS=http://localhost:5410,http://localhost:5420
